{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request.schema.json",
  "title": "AABridge request v1",
  "description": "One JSON object per line, maximum 131072 bytes. Duplicate keys, controls, non-finite numbers, unsafe paths and local-policy violations are rejected by runtime validation. Authenticated sender comes from the transport, never this body.",
  "$defs": {
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "recipient": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Normalized relative non-hidden file; runtime applies additional path checks."
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime_seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 86400
            },
            "max_turns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_revisions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "runtime_seconds",
            "max_turns",
            "max_revisions"
          ]
        },
        "permission_profile": {
          "type": "string",
          "enum": [
            "proposal-v1",
            "coding-v1"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "work",
            "plan",
            "review"
          ],
          "description": "Coding role: planning and review leave the checkout unchanged."
        },
        "model_settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\[\\]-]{0,159}$"
            },
            "effort": {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra",
                "ultracode"
              ]
            }
          },
          "description": "Task-scoped CLI settings. Omit a field to use the agent default. Model/effort availability is checked by the installed agent."
        }
      },
      "required": [
        "project_id",
        "recipient",
        "base_commit",
        "objective",
        "scope",
        "acceptance",
        "context",
        "limits",
        "permission_profile"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "permission_profile": {
                "const": "coding-v1"
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "const": [
                  "*"
                ]
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "mode"
              ]
            },
            "properties": {
              "limits": {
                "properties": {
                  "runtime_seconds": {
                    "maximum": 300
                  },
                  "max_turns": {
                    "maximum": 6
                  },
                  "max_revisions": {
                    "maximum": 3
                  }
                }
              },
              "context": {
                "items": {
                  "maxLength": 1000
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "model_settings"
            ]
          },
          "then": {
            "properties": {
              "permission_profile": {
                "const": "coding-v1"
              }
            }
          }
        }
      ]
    },
    "modelSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\[\\]-]{0,159}$"
        },
        "effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra",
            "ultracode"
          ]
        }
      },
      "description": "Task-scoped CLI settings. Omit a field to use the agent default. Model/effort availability is checked by the installed agent."
    }
  },
