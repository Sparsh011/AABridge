                "maxLength": 1000
              },
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true
            },
            "context": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "minItems": 0,
              "maxItems": 8,
              "uniqueItems": true
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "runtime_seconds": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 300
                },
                "max_turns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "max_revisions": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              },
              "required": [
                "runtime_seconds",
                "max_turns",
                "max_revisions"
              ]
            },
            "permission_profile": {
              "const": "proposal-v1"
            },
            "origin": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "human",
                    "agent"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "description": "Optional display provenance, never permission or human approval. Agent coordinators should include kind=agent and their actual agent name, preserving the same body on retries."
            }
          },
          "required": [
            "project_id",
            "recipient",
            "base_commit",
            "objective",
            "scope",
            "acceptance",
            "context",
            "limits",
            "permission_profile"
          ]
        }
      },
      "required": [
        "version",
        "op",
        "key",
        "body"
      ]
    },
