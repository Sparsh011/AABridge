            },
            "base_commit": {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Normalized relative non-hidden file; runtime applies additional path checks."
              },
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true
            },
            "acceptance": {
              "type": "array",
              "items": {
                "type": "string",
