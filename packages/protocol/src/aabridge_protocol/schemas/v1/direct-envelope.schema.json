{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AABridge direct TLS envelope v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "request"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "rpc"
        },
        "request": {
          "$ref": "request.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "task_id",
        "commit"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "result_bundle"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    }
  ]
}
