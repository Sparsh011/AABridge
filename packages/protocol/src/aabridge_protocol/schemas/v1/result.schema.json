{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "AABridge verified result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "base_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "result_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "worktree": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "profile": {
                "const": "integer-function-v1"
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "exit_code": {
                "const": 0
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "expected": {
                      "type": "integer"
                    },
                    "actual": {
                      "type": "integer"
                    },
                    "exit_code": {
                      "const": 0
                    }
                  },
                  "required": [
                    "args",
                    "expected",
                    "actual",
                    "exit_code"
                  ]
                }
              }
            },
            "required": [
              "profile",
              "file",
              "method",
              "exit_code",
              "cases"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "profile": {
                "const": "file-proposal-v1"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "method": {
                "type": "string"
              },
              "exit_code": {
                "const": 0
              },
              "review_required": {
                "const": true
              }
            },
            "required": [
              "profile",
              "files",
              "method",
              "exit_code",
              "review_required"
            ]
          }
        ]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "required": [
    "base_commit",
    "result_commit",
    "branch",
    "worktree",
    "changed_paths",
    "summary",
    "verification",
    "issues",
    "limitations"
  ]
}
