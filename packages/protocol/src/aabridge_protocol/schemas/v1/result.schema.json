{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "AABridge verified result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "base_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "result_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "worktree": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "profile": {
                "const": "integer-function-v1"
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "exit_code": {
                "const": 0
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "expected": {
                      "type": "integer"
                    },
                    "actual": {
                      "type": "integer"
                    },
                    "exit_code": {
                      "const": 0
                    }
                  },
                  "required": [
                    "args",
                    "expected",
                    "actual",
                    "exit_code"
                  ]
                }
              }
            },
            "required": [
              "profile",
              "file",
              "method",
              "exit_code",
              "cases"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "profile": {
                "const": "file-proposal-v1"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "method": {
                "type": "string"
              },
              "exit_code": {
                "const": 0
              },
              "review_required": {
                "const": true
              }
            },
            "required": [
              "profile",
              "files",
              "method",
              "exit_code",
              "review_required"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "review_required",
              "method"
            ],
            "properties": {
              "profile": {
                "const": "repository-v1"
              },
              "review_required": {
                "const": true
              },
              "method": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "linked": {
      "type": "array",
      "maxItems": 8,
      "description": "Linked projects the task could open. Edit links carry committed changes on the task branch; read links are always reset.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "access",
          "repository",
          "worktree",
          "branch",
          "base_commit",
          "result_commit",
          "changed_paths",
          "diff",
          "diff_truncated"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "access": {
            "enum": [
              "read",
              "edit"
            ]
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "worktree": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "base_commit": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "result_commit": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "changed_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "diff": {
            "type": "string",
            "maxLength": 64000
          },
          "diff_truncated": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "base_commit",
    "result_commit",
    "branch",
    "worktree",
    "changed_paths",
    "summary",
    "verification",
    "issues",
    "limitations"
  ]
}
